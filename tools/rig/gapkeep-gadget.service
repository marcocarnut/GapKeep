# Optional, for the rig (see docs/RIG.md): creates the Pi Zero's USB
# keyboard + mouse when the rig boots. Without it, run "sudo gadget.sh up"
# after every rig reboot, before resetting the Zero: a bound USB controller
# without a gadget hangs Circle's USB enumeration.
#
#   sudo install -d /opt/gapkeep-rig
#   sudo install -m 755 gadget.sh /opt/gapkeep-rig/
#   sudo install -m 644 gapkeep-gadget.service /etc/systemd/system/
#   sudo systemctl enable --now gapkeep-gadget.service
[Unit]
Description=GapKeep rig: USB keyboard + mouse gadget for the Pi Zero
After=sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/gapkeep-rig/gadget.sh up
ExecStop=/opt/gapkeep-rig/gadget.sh down

[Install]
WantedBy=multi-user.target
