From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GapKeep <noreply@gapkeep.org>
Date: Thu, 5 Nov 2026 19:20:00 -0300
Subject: [PATCH] QRDecoder: keep the corrected data codewords as an extra

A reader of what else a QR symbol carries (GapKeep's experimental colour
layer, lib/colorqr) needs the symbol's exact modules. zxing-cpp has the
data codewords after Reed-Solomon correction only inside Decode(); keep a
copy, as hex, in the extra "DataCodewords" (model 2 codes only), so the
caller can rebuild the symbol instead of reading the modules again.

---
--- a/core/src/qrcode/QRDecoder.cpp
+++ b/core/src/qrcode/QRDecoder.cpp
@@ -361,12 +361,25 @@
 	auto versionStr = version.isRMQR() ? "R" + ToString(Version::SymbolSize(version.versionNumber(), version.type()), true)
 									   : (version.isMicro() ? "M" : "") + std::to_string(version.versionNumber());
 
+	// gapkeep: the corrected data codewords, block after block, as hex, for
+	// a reader of what else the symbol carries (colours: lib/colorqr)
+	std::string dataHex;
+	if (version.isModel2()) {
+		static const char digits[] = "0123456789abcdef";
+		dataHex.reserve(2 * resultBytes.size());
+		for (auto b : resultBytes) {
+			dataHex += digits[b >> 4];
+			dataHex += digits[b & 15];
+		}
+	}
+
 	// Decode the contents of that stream of bytes
 	auto ret = DecodeBitStream(std::move(resultBytes), version, formatInfo.ecLevel)
 		.setIsMirrored(formatInfo.isMirrored)
 		.addExtra(BarcodeExtra::DataMask, formatInfo.dataMask, uint8_t(255))
 		.addExtra(BarcodeExtra::UEC, uec, -1.0)
 		.addExtra(BarcodeExtra::Version, versionStr)
+		.addExtra("DataCodewords", dataHex)
 		;
 	if (error)
 		ret.setError(error);
