diff --git a/core/src/ZXConfig.h b/core/src/ZXConfig.h
index dfcd5a80..e8353ec2 100644
--- a/core/src/ZXConfig.h
+++ b/core/src/ZXConfig.h
@@ -10,8 +10,20 @@
 // your platform doesn't support thread_local, you can switch to static, but be aware that this makes the code not thread safe.
 // For Windows in Visual Studio 2019 on Intel 64-bit using thread_local causes a dependency to VCRUNTIME140_1.dll, so you need 2019
 // runtime DLLs instead of only 2015 version.
+#ifndef ZX_THREAD_LOCAL
 #define ZX_THREAD_LOCAL thread_local // '' (nothing), 'thread_local' or 'static'
+#endif
 
 // The Galois Field abstractions used in Reed-Solomon error correction code use more memory than required to improve performance (20% - 100%).
 // If RAM is scarce, you can define LIBRSCPP_SAVE_MEMORY to reduce memory usage. The effect is a few kB big.
 // #define LIBRSCPP_SAVE_MEMORY
+
+// Without C++ exceptions (-fno-exceptions), what the library would throw is a fatal error instead: a call to
+// ZXing::Fatal(), which the application provides and which must not return, with the throw expression as text.
+// (The QR code reader reports errors in a symbol's data in Barcode::error(), it does not throw on them.)
+#if defined(__cpp_exceptions) || defined(_CPPUNWIND)
+#define ZX_THROW(...) throw __VA_ARGS__
+#else
+namespace ZXing { [[noreturn]] void Fatal(const char* what); }
+#define ZX_THROW(...) ::ZXing::Fatal(#__VA_ARGS__)
+#endif
