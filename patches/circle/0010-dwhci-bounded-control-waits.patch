+unsigned CDWHCIDevice::GetControlTimeout (unsigned nTimeoutMs)
+{
+	// the budget of full-length timeouts (see dwhcidevice.h), refilled
+	// one per USB_CONTROL_CREDIT_MS from the first one used
+	unsigned nNow = CTimer::Get ()->GetTicks ();
+	if (m_nTimeoutCredit >= USB_CONTROL_TIMEOUT_CREDIT)
+	{
+		m_nTimeoutCreditTicks = nNow;
+	}
+	while (   m_nTimeoutCredit < USB_CONTROL_TIMEOUT_CREDIT
+	       && nNow - m_nTimeoutCreditTicks >= MSEC2HZ (USB_CONTROL_CREDIT_MS))
+	{
+		m_nTimeoutCredit++;
+		m_nTimeoutCreditTicks += MSEC2HZ (USB_CONTROL_CREDIT_MS);
+	}
+
+	unsigned nResult = USB_CONTROL_TIMEOUT_MS;
+	if (   nTimeoutMs != USB_TIMEOUT_NONE
+	    && nTimeoutMs < nResult)
+	{
+		nResult = nTimeoutMs;
+	}
+
+	if (   m_nTimeoutCredit == 0
+	    && nResult > USB_CONTROL_SHORT_TIMEOUT_MS)
+	{
+		nResult = USB_CONTROL_SHORT_TIMEOUT_MS;
+	}
+
+	return nResult;
+}
