+//
+// usbmousereport.h
+//
+// gapkeep: the USB mouse's HID report descriptor parser and report field
+// extraction, taken out of usbmouse.cpp and bounded: the descriptor and
+// the reports come from the device, so every length, index and offset in
+// them is checked. Kept apart from the driver so that it can be compiled
+// and fuzzed on its own (GapKeep's tools/fuzz_usbmouse.sh).
+//
+// Circle - A C++ bare metal environment for Raspberry Pi
+// Copyright (C) 2014-2026  R. Stange <rsta2@gmx.net>
+//
+// USB mouse wheel support including HID report parser:
+// Copyright (C) 2020  H. Kocevar <hinxx@protonmail.com>
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+//
+#ifndef _circle_usb_usbmousereport_h
+#define _circle_usb_usbmousereport_h
+
+#include <circle/types.h>
+
+enum TMouseReportType
+{
+	MouseItemButtons,
+	MouseItemXAxis,
+	MouseItemYAxis,
+	MouseItemWheel,
+
+	MouseItemCount
+};
+
+struct TMouseReportItem
+{
+	unsigned bitSize;
+	unsigned bitOffset;
+};
+
+struct TMouseReport
+{
+	unsigned id;			// report ID (first byte of each report), 0: none
+	unsigned byteSize;		// 0: no mouse described
+	TMouseReportItem items[MouseItemCount];
+};
+
+#define USBMOUSE_MAX_DESCRIPTOR_SIZE	4096	// report descriptor, bytes
+#define USBMOUSE_MAX_REPORT_SIZE	64	// mouse report, bytes (with its ID)
+#define USBMOUSE_MAX_COLLECTION_DEPTH	16
+
+// Fills *pReport from a report descriptor. Returns 0 if it is well-formed
+// (pReport->byteSize == 0 then means that it describes no mouse), else a
+// short description of what is wrong with it, and *pReport is all zero.
+const char *USBMouseDecodeReport (const u8 *pDescriptor, unsigned nLength,
+				  TMouseReport *pReport);
+
+// A field of a report of nReportSize bytes; a field that is not entirely
+// inside the report reads as 0. nBitSize up to 32.
+u32 USBMouseExtractUnsigned (const u8 *pReport, unsigned nReportSize,
+			     unsigned nBitOffset, unsigned nBitSize);
+s32 USBMouseExtractSigned (const u8 *pReport, unsigned nReportSize,
+			   unsigned nBitOffset, unsigned nBitSize);
+
+#endif
