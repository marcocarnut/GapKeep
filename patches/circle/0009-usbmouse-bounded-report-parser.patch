-	if (length > 16) number |= (u32) bits[2] << 16;
-	offset = shift;
-
-	unsigned result = 0;
-	if (length > 24)
-	{
-		result = (((1 << 24) - 1) & (number >> offset));
-		bits = bits + 3;
