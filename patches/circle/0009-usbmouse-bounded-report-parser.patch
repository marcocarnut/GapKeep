diff --git a/lib/usb/usbmousereport.cpp b/lib/usb/usbmousereport.cpp
new file mode 100644
index 0000000..03e3720
--- /dev/null
+++ b/lib/usb/usbmousereport.cpp
@@ -0,0 +1,332 @@
+//
+// usbmousereport.cpp
+//
+// gapkeep: the USB mouse's HID report descriptor parser, out of
+// usbmouse.cpp, with every length, index and offset checked (see
+// usbmousereport.h). For a well-formed descriptor it finds what the
+// original parser found.
+//
+// Circle - A C++ bare metal environment for Raspberry Pi
+// Copyright (C) 2014-2026  R. Stange <rsta2@gmx.net>
+//
+// USB mouse wheel support including HID report parser:
+// Copyright (C) 2020  H. Kocevar <hinxx@protonmail.com>
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+//
+#include <circle/usb/usbmousereport.h>
+
+// HID Report Items from HID 1.11 Section 6.2.2
+#define HID_USAGE_PAGE      0x04
+#define HID_USAGE           0x08
+#define HID_COLLECTION      0xA0
+#define HID_END_COLLECTION  0xC0
+#define HID_REPORT_COUNT    0x94
+#define HID_REPORT_SIZE     0x74
+#define HID_INPUT           0x80
+#define HID_REPORT_ID       0x84
+#define HID_LONG_ITEM       0xFE
+
+// HID Report Usage Pages from HID Usage Tables 1.12 Section 3, Table 1
+#define HID_USAGE_PAGE_BUTTONS         0x09
+
+// HID Report Usages from HID Usage Tables 1.12 Section 4, Table 6
+#define HID_USAGE_POINTER   0x01
+#define HID_USAGE_MOUSE     0x02
+#define HID_USAGE_X         0x30
+#define HID_USAGE_Y         0x31
+#define HID_USAGE_WHEEL     0x38
+
+#define MAX_REPORT_BITS     (USBMOUSE_MAX_REPORT_SIZE * 8)
+
+static void ClearReport (TMouseReport *pReport)
+{
+	pReport->id = 0;
+	pReport->byteSize = 0;
+	for (unsigned i = 0; i < MouseItemCount; i++)
+	{
+		pReport->items[i].bitSize = 0;
+		pReport->items[i].bitOffset = 0;
+	}
+}
+
+static const char *Fail (TMouseReport *pReport, const char *pWhy)
+{
+	ClearReport (pReport);
+
+	return pWhy;
+}
+
+const char *USBMouseDecodeReport (const u8 *pDescriptor, unsigned nLength,
+				  TMouseReport *pReport)
+{
+	u32 offset = 0, size = 0, count = 0;	// offset: bits, at most MAX_REPORT_BITS
+	u32 id = 0;
+	u32 nCollections = 0;
+	u32 itemIndex = 0;
+	boolean parse = FALSE;
+	boolean foundMouseUsage = FALSE;
+	u32 itemIndexes[MouseItemCount] = {0};
+
+	// items the descriptor does not describe (no wheel, say) must read as
+	// absent, not as whatever was on the heap
+	ClearReport (pReport);
+
+	if (pDescriptor == 0)
+	{
+		return "no descriptor";
+	}
+
+	if (nLength > USBMOUSE_MAX_DESCRIPTOR_SIZE)
+	{
+		return Fail (pReport, "descriptor too long");
+	}
+
+	unsigned i = 0;
+	while (i < nLength)
+	{
+		u8 prefix = pDescriptor[i++];
+
+		if (prefix == HID_LONG_ITEM)		// HID 1.11 6.2.2.3: size, tag, data
+		{
+			if (nLength - i < 2)
+			{
+				return Fail (pReport, "truncated long item");
+			}
+			unsigned nDataSize = pDescriptor[i];
+			i += 2;
+			if (nLength - i < nDataSize)
+			{
+				return Fail (pReport, "truncated long item");
+			}
+			i += nDataSize;
+
+			continue;
+		}
+
+		unsigned nArgSize = prefix & 0x03;
+		if (nArgSize == 3)
+		{
+			nArgSize = 4;
+		}
+		if (nLength - i < nArgSize)
+		{
+			return Fail (pReport, "truncated item");
+		}
+
+		// unsigned: the items read here (usages, sizes, counts, IDs) are
+		u32 arg = 0;
+		for (unsigned k = 0; k < nArgSize; k++)
+		{
+			arg |= (u32) pDescriptor[i++] << (8 * k);
+		}
+
+		switch (prefix & 0xFC)
+		{
+		case HID_COLLECTION:
+			if (++nCollections > USBMOUSE_MAX_COLLECTION_DEPTH)
+			{
+				return Fail (pReport, "collections nested too deep");
+			}
+			break;
+		case HID_END_COLLECTION:
+			if (nCollections == 0)
+			{
+				return Fail (pReport, "end of a collection never opened");
+			}
+			nCollections--;
+			if (nCollections == 0)
+				parse = FALSE;
+			break;
+		case HID_USAGE:
+			if (arg == HID_USAGE_MOUSE)
+			{
+				foundMouseUsage = TRUE;
+			}
+			else if (arg == HID_USAGE_POINTER)
+			{
+				if (id == 0)
+				{
+					parse = TRUE;
+				}
+			}
+			break;
+		case HID_REPORT_ID:
+			if (foundMouseUsage)
+			{
+				if (arg == 0 || arg > 0xFF)	// HID 1.11 6.2.2.7
+				{
+					return Fail (pReport, "bad report ID");
+				}
+
+				if (id == 0)
+				{
+					if (offset != 0)
+					{
+						return Fail (pReport, "report ID after report data");
+					}
+					id = arg;
+					offset += 8;
+					parse = TRUE;
+				}
+				else
+				{
+					parse = arg == id ? TRUE : FALSE;
+				}
+			}
+			break;
+		}
+
+		if (! parse)
+			continue;
+
+		u32 newItem = MouseItemCount;
+		switch(prefix & 0xFC)
+		{
+		case HID_USAGE_PAGE:
+			if (arg == HID_USAGE_PAGE_BUTTONS)
+			{
+				newItem = MouseItemButtons;
+			}
+			break;
+		case HID_USAGE:
+			switch(arg)
+			{
+			case HID_USAGE_X:
+				newItem = MouseItemXAxis;
+				break;
+			case HID_USAGE_Y:
+				newItem = MouseItemYAxis;
+				break;
+			case HID_USAGE_WHEEL:
+				newItem = MouseItemWheel;
+				break;
+			}
+			break;
+		case HID_REPORT_SIZE:
+			if (arg > 32)
+			{
+				return Fail (pReport, "report size over 32 bits");
+			}
+			size = arg;
+			break;
+		case HID_REPORT_COUNT:
+			if (arg > MAX_REPORT_BITS)
+			{
+				return Fail (pReport, "report count too large");
+			}
+			count = arg;
+			break;
+		case HID_INPUT:
+			if ((arg & 0x03) == 0x02)
+			{
+				u32 bitOffset = offset;
+				for (u32 index = 0; index < itemIndex; index++)
+				{
+					u32 item = itemIndexes[index];
+					u32 bitSize = item == MouseItemButtons ? count : size;
+					if (bitSize > 32)
+					{
+						return Fail (pReport, "more than 32 buttons");
+					}
+					pReport->items[item].bitSize = bitSize;
+					pReport->items[item].bitOffset = bitOffset;
+					bitOffset += bitSize;	// <= MAX_REPORT_BITS + 4*32
+				}
+				itemIndex = 0;
+			}
+
+			// both <= MAX_REPORT_BITS: no overflow in u32
+			if (count * size > MAX_REPORT_BITS - offset)
+			{
+				return Fail (pReport, "report too long");
+			}
+			offset += count * size;
+			break;
+		}
+
+		if (newItem < MouseItemCount)
+		{
+			if (itemIndex >= MouseItemCount)
+			{
+				return Fail (pReport, "too many usages before an input item");
+			}
+			itemIndexes[itemIndex++] = newItem;
+		}
+	}
+
+	pReport->id = id;
+	pReport->byteSize = (offset + 7) / 8;
+	if (   pReport->byteSize == 0
+	    || (id != 0 && pReport->byteSize == 1))	// an ID and nothing else
+	{
+		ClearReport (pReport);
+
+		return 0;				// not a mouse
+	}
+
+	// every field inside the report (the original parser could place one
+	// after its end, when an input item had fewer fields than usages)
+	for (unsigned item = 0; item < MouseItemCount; item++)
+	{
+		const TMouseReportItem *pItem = &pReport->items[item];
+		if (   pItem->bitSize > 0
+		    && pItem->bitOffset + pItem->bitSize > pReport->byteSize * 8)
+		{
+			return Fail (pReport, "field outside the report");
+		}
+	}
+
+	return 0;
+}
+
+u32 USBMouseExtractUnsigned (const u8 *pReport, unsigned nReportSize,
+			     unsigned nBitOffset, unsigned nBitSize)
+{
+	if (   pReport == 0
+	    || nBitSize == 0
+	    || nBitSize > 32
+	    || nReportSize > USBMOUSE_MAX_REPORT_SIZE
+	    || nBitOffset > nReportSize * 8
+	    || nBitSize > nReportSize * 8 - nBitOffset)
+	{
+		return 0;
+	}
+
+	u32 nResult = 0;
+	for (unsigned i = 0; i < nBitSize; i++)
+	{
+		unsigned nBit = nBitOffset + i;
+		if ((pReport[nBit / 8] >> (nBit % 8)) & 1)
+		{
+			nResult |= (u32) 1 << i;
+		}
+	}
+
+	return nResult;
+}
+
+s32 USBMouseExtractSigned (const u8 *pReport, unsigned nReportSize,
+			   unsigned nBitOffset, unsigned nBitSize)
+{
+	u32 nResult = USBMouseExtractUnsigned (pReport, nReportSize, nBitOffset, nBitSize);
+	if (   nBitSize > 0
+	    && nBitSize < 32
+	    && (nResult & ((u32) 1 << (nBitSize - 1))))
+	{
+		nResult |= ~(((u32) 1 << nBitSize) - 1);
+	}
+
+	return (s32) nResult;
+}
